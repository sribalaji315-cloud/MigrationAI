# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Admin account (created on first startup if no admin exists)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Database (SQLite). Ignored under docker-compose, which sets
# DATABASE_URL=sqlite:////app/data/app.db on the db_data volume.
DATABASE_URL=sqlite:///backend/dev.db

# Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ML prediction service. Shared secret between the backend and ml_predict_service;
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_SERVICE_API_KEY=
# Ignored under docker-compose, which points the backend at http://ml-predict:8000
ML_SERVICE_URL=http://localhost:8014

# Login rate limiter. Ignored under docker-compose, which uses the redis service.
REDIS_URL=

# Public origins, required by docker-compose.prod.yml only
PUBLIC_APP_ORIGIN=https://hwds.svartalfheim.io
PUBLIC_API_ORIGIN=https://hwds-dev.svartalfheim.io

# Frontend feature flag, baked in at build time
VITE_USE_NEW_CLASS_TARGET_MAPPING=false
