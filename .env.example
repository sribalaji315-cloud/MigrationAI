# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Admin account (created on first startup if no admin exists)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=sqlite:///backend/dev.db
# For PostgreSQL (docker-compose):
# DATABASE_URL=postgresql://user:pass@localhost:5432/erp_migrator

# Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# PostgreSQL (docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=erp_migrator
